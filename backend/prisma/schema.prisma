// ============================================================================
// schema.prisma — SaaS de gestion de tontines sénégalaises
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN    // Administrateur de la plateforme SaaS
  ADMIN_TONTINE  // Créateur / gestionnaire d'une tontine spécifique
  MEMBER         // Participant simple
}

enum TontineType {
  CLASSIQUE        // Rotation simple : chaque membre reçoit la cagnotte à tour de rôle
  INVESTISSEMENT   // Cagnotte destinée à un projet commun (pas de rotation individuelle)
}

enum TontineFrequency {
  QUOTIDIENNE
  HEBDOMADAIRE
  MENSUELLE
}

// Jour de la semaine (UTC) auquel les cotisations sont dues.
enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

enum TontineStatus {
  EN_ATTENTE   // Créée mais pas encore démarrée (en cours de recrutement)
  ACTIVE
  SUSPENDUE
  TERMINEE
}

enum MemberStatus {
  ACTIF
  EN_RETARD     // A des cotisations impayées
  EXCLU
  SORTIE        // A déjà reçu son tour et la tontine continue pour les autres
}

enum TransactionType {
  COTISATION          // Paiement d'un membre vers la cagnotte
  VERSEMENT_GAGNANT    // Versement de la cagnotte nette au bénéficiaire du tour
  COMMISSION           // Commission SaaS prélevée sur une cotisation
  AMENDE_RETARD        // Amende de retard intégralement versée au bénéficiaire du tour
  ABONNEMENT           // Paiement d'un abonnement SaaS par un ADMIN_TONTINE
  PASSAGE_ADMIN        // Paiement unique MEMBER -> ADMIN_TONTINE (1000 F par défaut)
  REMBOURSEMENT
}

enum TransactionStatus {
  EN_ATTENTE
  REUSSIE
  ECHOUEE
  ANNULEE
}

enum PaymentProvider {
  WAVE
  ORANGE_MONEY
  PAYTECH
  PAYDUNYA
  ESPECES
  VIREMENT
}

enum PlanAbonnement {
  GRATUIT     // Limité en nombre de tontines / membres
  STANDARD
  PREMIUM
}

// Phase 3 : l'adhésion directe par code est remplacée par une demande validée
// par l'administrateur de la tontine.
enum StatutDemandeAdhesion {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

// ----------------------------------------------------------------------------
// UTILISATEURS
// ----------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  telephone     String   @unique // Format E.164, ex: +221771234567
  passwordHash  String
  nom           String
  prenom        String
  role          Role     @default(MEMBER)
  // Un seul SUPER_ADMIN principal : désigné au seed/CLI par SUPER_ADMIN_PRINCIPAL_EMAIL.
  // Champ immuable via l'API (aucun DTO ni route ne l'expose en écriture).
  estPrincipal  Boolean  @default(false)
  isBlocked     Boolean  @default(false) // Action du Super-Admin (back-office)
  isVerified    Boolean  @default(false) // Vérification OTP téléphone
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tontinesCreees     Tontine[]        @relation("TontineCreateur")
  participations     TontineMember[]
  transactions       Transaction[]
  transactionsRecues Transaction[]   @relation("BeneficiaireTransaction")
  amendesRecues      AmendeRetard[]  @relation("BeneficiaireAmende")
  abonnement         Subscription?
  pendingPayments    PendingPayment[]
  notifications      Notification[]
  demandesAdhesion   DemandeAdhesion[]

  @@index([role])
  @@map("users")
}

// ----------------------------------------------------------------------------
// ABONNEMENT SAAS (Monétisation B2B — ADMIN_TONTINE paie pour gérer ses tontines)
// ----------------------------------------------------------------------------

model Subscription {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id])
  plan          PlanAbonnement @default(GRATUIT)
  prixMensuel   Decimal        @db.Decimal(12, 2) @default(0)
  dateDebut     DateTime       @default(now())
  dateFin       DateTime?
  actif         Boolean        @default(true)
  // Phase 6 : une seule période d'essai gratuite par utilisateur, et trace
  // de l'essai en cours pour l'affichage du statut côté client.
  aUtiliseEssai Boolean        @default(false)
  enEssai       Boolean        @default(false)

  @@map("subscriptions")
}

// ----------------------------------------------------------------------------
// PARAMÈTRES FINANCIERS DE LA PLATEFORME (singleton, surchargeable par .env)
// ----------------------------------------------------------------------------

model ParametresPlateforme {
  id               String   @id @default(cuid())
  cle              String   @unique @default("global")
  tauxCommission   Decimal  @db.Decimal(5, 4) @default(0.03) // 3% par cotisation
  tauxAmende       Decimal  @db.Decimal(5, 4) @default(0.10) // 10% de la cotisation due
  delaiGraceHeures Int      @default(24)
  // Phase 3 : délai entre l'avertissement et la suppression effective d'une tontine.
  delaiAvertissementSuppressionJours Int @default(7)
  // Phase 4 : nombre maximum de SUPER_ADMIN de la plateforme (défaut 3).
  nombreMaxSuperAdmins Int @default(3)
  // Phase 6 : grille d'abonnements, entièrement configurable (FCFA entiers).
  prixStandardFcfa         Int @default(5000)
  prixPremiumFcfa          Int @default(15000)
  // Frais unique de passage MEMBER -> ADMIN_TONTINE, surchargeable par FRAIS_PASSAGE_ADMIN.
  fraisPassageAdminFcfa    Int @default(1000)
  limiteTontinesGratuites  Int @default(1)
  limiteTontinesStandard   Int @default(5)
  dureeEssaiJours          Int @default(14)
  dureeAbonnementJours     Int @default(30)
  updatedAt        DateTime @updatedAt

  @@map("parametres_plateforme")
}

// ----------------------------------------------------------------------------
// TONTINES
// ----------------------------------------------------------------------------

model Tontine {
  id                String            @id @default(cuid())
  nom               String
  description       String?
  type              TontineType       @default(CLASSIQUE)
  montantCotisation Decimal           @db.Decimal(12, 2) // Montant fixe par cycle et par membre
  frequence         TontineFrequency  @default(MENSUELLE) // Conservé pour compatibilité ; les échéances sont hebdomadaires
  jourCotisation    JourSemaine       @default(LUNDI) // Jour UTC de la cotisation hebdomadaire
  tauxCommission    Decimal           @db.Decimal(5, 4)  @default(0.03) // 3% par défaut, aligné sur ParametresPlateforme
  nombreMaxMembres  Int
  statut            TontineStatus     @default(EN_ATTENTE)
  dateDebut         DateTime?
  cycleActuel       Int               @default(1) // Index du tour en cours
  codeInvitation    String            @unique // Code unique pour retrouver la tontine via lien

  // Suppression sécurisée (Super-Admin) : avertissement puis délai de 7 jours.
  suppressionDemandeeAt DateTime?

  createurId        String
  createur           User             @relation("TontineCreateur", fields: [createurId], references: [id])

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  membres            TontineMember[]
  demandesAdhesion   DemandeAdhesion[]
  transactions       Transaction[]
  amendesRetard      AmendeRetard[]
  pendingPayments    PendingPayment[]

  @@index([statut])
  @@map("tontines")
}

// ----------------------------------------------------------------------------
// PARTICIPATIONS (table de jointure enrichie User <-> Tontine)
// ----------------------------------------------------------------------------

model TontineMember {
  id             String       @id @default(cuid())
  tontineId      String
  tontine        Tontine      @relation(fields: [tontineId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  ordrePassage   Int          // Rang du membre dans la rotation (1, 2, 3...)
  statut         MemberStatus @default(ACTIF)
  aDejaRecu      Boolean      @default(false) // A déjà touché la cagnotte de son tour
  dateReception  DateTime?    // Date à laquelle il/elle a reçu sa cagnotte

  joinedAt       DateTime     @default(now())

  transactions   Transaction[]
  amendesRetard  AmendeRetard[]
  pendingPayments PendingPayment[]

  @@unique([tontineId, userId])       // Un membre ne peut rejoindre qu'une fois la même tontine
  @@unique([tontineId, ordrePassage]) // Un seul membre par rang dans une tontine donnée
  @@map("tontine_members")
}

// ----------------------------------------------------------------------------
// DEMANDES D'ADHÉSION (Phase 3)
// ----------------------------------------------------------------------------

model DemandeAdhesion {
  id           String                @id @default(cuid())
  tontineId    String
  tontine      Tontine               @relation(fields: [tontineId], references: [id], onDelete: Cascade)
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  statut       StatutDemandeAdhesion @default(EN_ATTENTE)
  motifRefus   String?
  traiteeParId String?
  createdAt    DateTime              @default(now())
  traiteeAt    DateTime?

  @@index([tontineId, statut])
  @@index([userId])
  @@map("demandes_adhesion")
}

// ----------------------------------------------------------------------------
// TRANSACTIONS (cœur de la traçabilité financière + monétisation)
// ----------------------------------------------------------------------------

model Transaction {
  id                String             @id @default(cuid())

  type              TransactionType
  statut            TransactionStatus  @default(EN_ATTENTE)
  provider          PaymentProvider?
  referenceExterne  String?            // ID de transaction retourné par Wave/Orange Money/PayTech

  montantBrut       Decimal            @db.Decimal(12, 2) // Montant total avant commission
  montantCommission Decimal            @db.Decimal(12, 2) @default(0) // Part prélevée par le SaaS
  montantNet        Decimal            @db.Decimal(12, 2) // Montant réellement transféré (cagnotte ou versement)

  userId            String
  user              User               @relation(fields: [userId], references: [id])

  // Amendes de retard : le payeur est `user`, le bénéficiaire du tour est `beneficiaire`.
  beneficiaireUserId String?
  beneficiaire       User?              @relation("BeneficiaireTransaction", fields: [beneficiaireUserId], references: [id])
  amendeRetard       AmendeRetard?

  tontineId         String?
  tontine           Tontine?           @relation(fields: [tontineId], references: [id])

  tontineMemberId   String?
  tontineMember     TontineMember?     @relation(fields: [tontineMemberId], references: [id])

  cycleConcerne     Int?               // Numéro du tour concerné par la cotisation/versement

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([type, statut])
  @@index([tontineId])
  @@map("transactions")
}

// ----------------------------------------------------------------------------
// AMENDES DE RETARD (une seule par cotisation en retard, bénéficiaire = tour en cours)
// ----------------------------------------------------------------------------

model AmendeRetard {
  id                String        @id @default(cuid())
  tontineId         String
  tontine           Tontine       @relation(fields: [tontineId], references: [id])
  tontineMemberId   String
  tontineMember     TontineMember @relation(fields: [tontineMemberId], references: [id])
  cycleConcerne     Int           // Cycle de la cotisation impayée
  montant           Decimal       @db.Decimal(12, 2)
  beneficiaireUserId String
  beneficiaire      User          @relation("BeneficiaireAmende", fields: [beneficiaireUserId], references: [id])
  transactionId     String?       @unique
  transaction       Transaction?  @relation(fields: [transactionId], references: [id])
  createdAt         DateTime      @default(now())

  @@unique([tontineMemberId, cycleConcerne])
  @@index([tontineId])
  @@map("amendes_retard")
}

// ----------------------------------------------------------------------------
// NOTIFICATIONS (alertes in-app pour les membres)
// ----------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  titre     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  // Lien interne optionnel vers la page concernée (ex: gestion d'une demande).
  lien      String?
  lue       Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, lue])
  @@map("notifications")
}

// ----------------------------------------------------------------------------
// PAIEMENTS EN ATTENTE (liaison entre initiation et webhook asynchrone)
// ----------------------------------------------------------------------------

model PendingPayment {
  id               String    @id @default(cuid())
  // COTISATION (tontine + membre requis) ou PASSAGE_ADMIN (aucune tontine).
  type             String    @default("COTISATION")
  tontineId        String?
  tontine          Tontine?  @relation(fields: [tontineId], references: [id])
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  tontineMemberId  String?
  tontineMember    TontineMember? @relation(fields: [tontineMemberId], references: [id])

  provider         PaymentProvider
  referenceInterne String    @unique // Clé de liaison envoyée au provider (ex: "tontineId:userId:timestamp")
  referenceExterne String?   // ID retourné par le provider après initiation
  montantBrut      Decimal   @db.Decimal(12, 2)
  cycleConcerne    Int?      // Cycle réglé (cotisation courante ou arriéré)

  statut           String    @default("EN_ATTENTE") // EN_ATTENTE, REUSSIE, ECHOUEE, ANNULEE
  webhookRecu      Boolean   @default(false)
  dateWebhook      DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tontineId, userId])
  @@index([type, statut])
  @@index([statut])
  @@map("pending_payments")
}

// ----------------------------------------------------------------------------
// AUDIT LOG (traçabilité des actions sensibles du back-office)
// ----------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  action       String   // ex: "USER_BLOCKED", "USER_UNBLOCKED", "TONTINE_SUSPENDED"
  cible        String   // id de l'entité affectée (ex: userId)
  details      String?  // description libre / JSON stringifié
  acteurId     String   // id du SUPER_ADMIN ayant réalisé l'action
  createdAt    DateTime @default(now())

  @@index([acteurId])
  @@map("audit_logs")
}
