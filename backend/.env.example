# Base de données (correspond au docker-compose.yml fourni à la racine)
DATABASE_URL="postgresql://tontine:tontine@localhost:5433/tontine_saas?schema=public"

# Auth
JWT_SECRET="change-moi-en-production-avec-une-vraie-cle-secrete-longue"

# Frontend (pour CORS)
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3001"

PORT=3001

# Secrets de webhook : valeurs DEV non vides pour pouvoir tester les signatures
# HMAC en local. À remplacer par de vraies valeurs (et jamais les committer) en prod.
# Wave
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET="dev-wave-webhook-secret-change-me"

# Orange Money
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_WEBHOOK_SECRET="dev-orange-webhook-secret-change-me"

# PayTech / PayDunya
PAYTECH_API_KEY=""
PAYTECH_API_SECRET="dev-paytech-api-secret-change-me"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Email (code de vérification à l'inscription)
# Sans ces variables, le code est affiché dans les logs du backend ([EMAIL SIMULÉ]).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="vous@gmail.com"
# SMTP_PASS="mot-de-passe-ou-app-password"
# MAIL_FROM="Tontine SaaS <no-reply@exemple.com>"
