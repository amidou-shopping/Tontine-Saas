# Base de données (correspond au docker-compose.yml fourni à la racine)
DATABASE_URL="postgresql://tontine:tontine@localhost:5433/tontine_saas?schema=public"

# Auth
JWT_SECRET="change-moi-en-production-avec-une-vraie-cle-secrete-longue"

# Frontend (pour CORS)
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3001"

PORT=3001

# Environnement : "production" interdit formellement le seed du compte démo.
NODE_ENV="development"

# Gouvernance (Phase 4) : laissez vide pour utiliser ParametresPlateforme.nombreMaxSuperAdmins (3).
MAX_SUPER_ADMINS=""

# Support (Phase 5) : numéros au format international SANS le '+' (placeholders fictifs).
# Remplacez par de vrais contacts dans votre environnement de production, jamais dans ce fichier.
SUPPORT_1_NAME="Support Wave"
SUPPORT_1_PHONE="221000000000"
SUPPORT_2_NAME="Support Orange Money"
SUPPORT_2_PHONE="221000000001"
SUPPORT_3_NAME="Support technique"
SUPPORT_3_PHONE="221000000002"

# Règles financières (laissez vide pour utiliser les valeurs de la table ParametresPlateforme)
# Taux décimaux : 0.03 = 3 % de commission, 0.10 = 10 % d'amende de retard.
TAUX_COMMISSION_PLATEFORME=""
TAUX_AMENDE_RETARD=""
DELAI_GRACE_HEURES=""
# Gouvernance (Phase 3) : jours entre l'avertissement et la suppression d'une tontine.
DELAI_AVERTISSEMENT_SUPPRESSION_JOURS=""

# Abonnements (Phase 6) : laissez vide pour utiliser les valeurs de ParametresPlateforme.
# Montants en FCFA entiers, durées en jours entiers.
PRIX_STANDARD_FCFA=""
PRIX_PREMIUM_FCFA=""
LIMITE_TONTINES_GRATUITES=""
LIMITE_TONTINES_STANDARD=""
DUREE_ESSAI_JOURS=""
DUREE_ABONNEMENT_JOURS=""

# Secrets de webhook : valeurs DEV non vides pour pouvoir tester les signatures
# HMAC en local. À remplacer par de vraies valeurs (et jamais les committer) en prod.
# Wave
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET="dev-wave-webhook-secret-change-me"

# Orange Money
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_WEBHOOK_SECRET="dev-orange-webhook-secret-change-me"

# PayTech / PayDunya
PAYTECH_API_KEY=""
PAYTECH_API_SECRET="dev-paytech-api-secret-change-me"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Email (code de vérification à l'inscription)
# Sans ces variables, le code est affiché dans les logs du backend ([EMAIL SIMULÉ]).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="vous@gmail.com"
# SMTP_PASS="mot-de-passe-ou-app-password"
# MAIL_FROM="Tontine SaaS <no-reply@exemple.com>"
